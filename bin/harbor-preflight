#!/usr/bin/env bash
# Read-only Harbor/Pi/Codex readiness check. Never installs, runs a trial, or uploads.
set -euo pipefail
ORCHESTRATOR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
npm --prefix "$ORCHESTRATOR" run --silent build
exec node "$ORCHESTRATOR/dist/benchmark/harbor-preflight.js" "$@"
