#!/usr/bin/env bash
# Read-only Terminal-Bench corpus inventory. Never runs Docker, Harbor, a model, or a verifier.
set -euo pipefail
ORCHESTRATOR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
npm --prefix "$ORCHESTRATOR" run --silent build
exec node "$ORCHESTRATOR/dist/benchmark/corpus-inventory.js" "$@"
