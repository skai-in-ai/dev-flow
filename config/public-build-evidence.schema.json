{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-orchestrator/public-build-evidence-1",
  "title": "Public build-output evidence checks",
  "type": "array",
  "maxItems": 32,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "command", "cwd", "timeoutSeconds", "expectedExitCodes", "required", "mode", "stdoutMaxBytes", "stderrMaxBytes"],
    "properties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 96 },
      "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
      "cwd": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(?:/|$)).+$" },
      "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
      "expectedExitCodes": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
      "required": { "type": "boolean" },
      "mode": { "enum": ["observe", "blocking"] },
      "stdoutMaxBytes": { "type": "integer", "minimum": 1, "maximum": 1000000 },
      "stderrMaxBytes": { "type": "integer", "minimum": 1, "maximum": 1000000 },
      "diagnostics": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "pattern"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 96 },
            "kind": { "enum": ["literal", "regex"] },
            "pattern": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      }
    }
  }
}
